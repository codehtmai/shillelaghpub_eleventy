---
layout: base.njk
title: Visit the Club
---
<section class="wrap inside"><p class="eyebrow dark"><span></span>The Shillelagh</p><h1>Visit the Club</h1>
{% if club.address %}<p class="lede">{{ club.address }}</p><iframe class="embed map" title="Map of the club location" src="https://maps.google.com/maps?q={{ club.address | query }}&amp;output=embed" loading="lazy"></iframe><a class="textlink" href="https://www.google.com/maps/dir/?api=1&amp;destination={{ club.address | query }}">Get directions ↗</a>
{% else %}<div class="notice"><h2>Location &amp; directions</h2><p>The club is confirming its visitor information. Check back for the street address and map.</p></div>{% endif %}
{% if club.hours %}<h2>Opening hours</h2><p class="body-copy">{{ club.hours }}</p>{% endif %}</section>
